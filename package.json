{
  "name": "semester-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:import-assets": "node scripts/prepare-import-assets.mjs",
    "pretest": "npm run prepare:import-assets",
    "predev": "npm run prepare:import-assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:import-assets",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/write-deployment-headers.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src vite.config.ts serve.mjs scripts eslint.config.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high",
    "security:scan": "node scripts/security-scan.mjs",
    "repository:audit": "node scripts/repository-audit.mjs",
    "repository:manifest": "node scripts/repository-audit.mjs --write-manifest",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:hosted": "node scripts/verify-hosted.mjs",
    "verify": "npm run lint && npm run check && npm test && npm run build && npm run security:audit && npm run security:scan && npm run repository:audit && npm run verify:pages"
  },
  "engines": { "node": ">=22.13.0" },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@react-three/fiber": "^9.8.1",
    "@tesseract.js-data/eng": "1.0.0",
    "cmdk": "^1.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.48.0",
    "motion": "^12.0.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "7.0.0",
    "three": "^0.186.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.11"
  }
}
